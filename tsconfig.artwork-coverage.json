{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "react": ["app/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["app/node_modules/@types/react/jsx-runtime.d.ts"],
