{
  "name": "warplets-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "SKIP_JFS_VERIFICATION=true tsx watch src/server.ts",
    "dev:snap": "wrangler dev --env dev --port 8789",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "web:dev": "pnpm --dir web dev",
    "web:deploy:dev": "pnpm --dir web deploy:dev",
    "web:deploy:prod": "pnpm --dir web deploy:prod",
    "web:local:tunnel": "node scripts/dev-tunnel-web.mjs",
    "dev:dashboard": "localflare attach app/wrangler.toml --port 8890 --persist-to app/.wrangler/state --no-open",
    "inspect:d1:users": "wrangler d1 execute warplets --local --command \"SELECT id,fid,username,created_at FROM users ORDER BY id DESC LIMIT 50;\"",
    "inspect:d1:votes": "wrangler d1 execute warplets --local --command \"SELECT id,user_id,poll_option,created_at FROM votes ORDER BY id DESC LIMIT 100;\"",
    "inspect:kv:list": "wrangler kv key list --namespace-id 3f55e9bea2534955b833521a2f5b55e7 --local",
    "inspect:kv:poll": "wrangler kv key get poll_results --namespace-id 3f55e9bea2534955b833521a2f5b55e7 --local",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:discovery-archives": "node --test scripts/discovery-archive.test.mjs scripts/discovery-archive-pack.test.mjs scripts/discovery-evidence-objects.test.mjs scripts/discovery-evidence-sealed.test.mjs scripts/discovery-evidence-index.test.mjs scripts/discovery-evidence-references.test.mjs",
    "test:discovery-reference-runtime": "node scripts/discovery-reference-runtime-study.mjs",
    "test:discovery-capacity": "node --test scripts/discovery-metadata-capacity.test.mjs",
    "test:discovery-scratch": "tsx --test scripts/discovery-evidence-scratch-replay.test.ts",
    "test:discovery-recovery": "node --test scripts/discovery-evidence-key-recovery.test.mjs",
    "test:discovery-metadata-sealed": "node --test scripts/discovery-metadata-sealed.test.mjs",
    "test:discovery-read-store": "tsx --test scripts/discovery-evidence-read-parity.test.ts",
    "test:discovery-append-stage": "node --test scripts/discovery-evidence-append-stage.test.mjs",
    "test:discovery-publication": "node --test scripts/discovery-evidence-publication.test.mjs",
    "test:discovery-publication-read": "tsx --test scripts/discovery-evidence-publication-read.test.ts",
    "test:discovery-producer-batches": "tsx --test scripts/discovery-evidence-producer-batches.test.ts",
    "test:discovery-intents": "node --test scripts/discovery-evidence-intents.test.mjs",
    "test:discovery-producer-publication": "tsx --test scripts/discovery-evidence-producer-publication.test.ts",
    "test:discovery-candidate-target": "tsx --test scripts/discovery-evidence-candidate-target.test.ts",
    "test:discovery-candidate-metadata": "tsx --test scripts/discovery-candidate-metadata.test.ts",
    "security:preflight": "node scripts/security-preflight.mjs",
    "security:test": "node scripts/test-security-blocklist.mjs",
    "security:test:redirects": "node --test scripts/test-http-redirect-security.mjs",
    "security:test:solana-rpc": "node --test scripts/test-solana-rpc-dependency.mjs",
    "security:smoke": "node scripts/security-smoke.mjs",
    "warpmoji:generate": "node scripts/generate-warpmoji-data.mjs && node scripts/generate-warpmoji-popularity.mjs",
    "warpmoji:popularity": "node scripts/generate-warpmoji-popularity.mjs",
    "warpmoji:export-curated": "node --no-warnings scripts/warpmoji-curated-seed.mjs export",
    "warpmoji:import-curated": "node --no-warnings scripts/warpmoji-curated-seed.mjs import",
    "resend:identities:migrate": "node scripts/migrate-resend-identities.mjs",
    "resend:onboarding:provision": "tsx scripts/provision-resend-onboarding.ts",
    "deploy": "wrangler deploy"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "axios": "1.20.0",
      "basic-ftp@<6.2.1": "6.2.1",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "follow-redirects@>=1.16.0 <1.16.1": "1.16.1",
      "ip-address@>=10.1.1 <10.7.4": "10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "@solana/web3.js@1.98.4>jayson": "5.0.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    },
    "patchedDependencies": {
      "@trustwallet/connect-walletconnect@0.0.0": "patches/@trustwallet__connect-walletconnect@0.0.0.patch",
      "cuer@0.0.3": "patches/cuer@0.0.3.patch"
    }
  },
  "dependencies": {
    "@farcaster/snap": "^1.22.1",
    "@farcaster/snap-hono": "~1.5.12",
    "@noble/curves": "^2.0.0",
    "hono": "^4.13.13",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@hono/node-server": "^1.19.15",
    "@types/node": "^24.0.0",
    "localflare": "^0.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
