{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenx-meme-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": true},
  "vars": {"LOCAL_PREVIEW_ONLY": "true"},
  "d1_databases": [{"binding":"MEME_DB","database_name":"meme-local","migrations_dir":"migrations"}]
}
