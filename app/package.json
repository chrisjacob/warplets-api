{
  "name": "10x-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm performance:budget",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "performance:budget": "node ../scripts/check-performance-budget.mjs",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "local:tunnel": "node ../scripts/dev-tunnel-app.mjs",
    "local:tunnel:drop": "node ../scripts/dev-tunnel-drop.mjs",
    "local:tunnel:search": "node ../scripts/dev-tunnel-search.mjs",
    "security:preflight": "node ../scripts/security-preflight.mjs",
    "deploy:dev": "pnpm security:preflight && vite build --mode development && pnpm performance:budget && wrangler pages deploy dist --project-name 10x-app-dev --branch dev",
    "deploy:prod": "pnpm security:preflight && pnpm build && wrangler pages deploy dist --project-name 10x-app"
  },
  "dependencies": {
    "@farcaster/miniapp-node": "^0.2.0",
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/quick-auth": "0.0.6",
    "@floating-ui/react": "^0.27.19",
    "@neynar/react": "^1.2.22",
    "@neynar/ui": "^1",
    "@pigment-css/react": "^0.0.30",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "canvas-confetti": "^1.9.4",
    "hls.js": "^1.6.16",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^2.15.4",
    "swr": "^2.4.2",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@tailwindcss/vite": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "wrangler": "^4.0.0"
  }
}
