{
  "name": "10x-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm performance:budget",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "performance:budget": "node ../scripts/check-performance-budget.mjs",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "local:tunnel": "node ../scripts/dev-tunnel-app.mjs",
    "local:tunnel:app": "node ../scripts/dev-tunnel-app.mjs",
    "local:tunnel:drop": "node ../scripts/dev-tunnel-drop.mjs",
    "local:tunnel:warplet": "node ../scripts/dev-tunnel-warplet.mjs",
    "web-push:generate-keys": "node ../scripts/generate-vapid-keys.mjs",
    "security:preflight": "node ../scripts/security-preflight.mjs",
    "deploy:dev": "pnpm security:preflight && vite build --mode development && pnpm performance:budget && wrangler pages deploy dist --project-name 10x-app-dev --branch dev",
    "deploy:prod": "pnpm security:preflight && pnpm build && wrangler pages deploy dist --project-name 10x-app"
  },
  "dependencies": {
    "@base-org/account": "^2.5.8",
    "@cloudflare/puppeteer": "^1.2.0",
    "@farcaster/auth-client": "0.7.1",
    "@farcaster/auth-kit": "0.8.2",
    "@farcaster/miniapp-node": "^0.2.0",
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/quick-auth": "0.0.6",
    "@floating-ui/react": "^0.27.19",
    "@neynar/ui": "^1",
    "@pigment-css/react": "^0.0.30",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/react-query": "^5.101.4",
    "@trustwallet/connect-eip155-react": "0.0.0",
    "@trustwallet/connect-react": "0.0.0",
    "@trustwallet/connect-walletconnect": "0.0.0",
    "canvas-confetti": "^1.9.4",
    "hls.js": "^1.6.16",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "ox": "^1.6.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^2.15.4",
    "swr": "^2.4.2",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.47.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/vite": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.10",
    "wrangler": "4.115.0"
  }
}
