{
  "name": "@10x/meme-qa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:custody": "node ../../meme/node_modules/tsx/dist/cli.mjs --test custody/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "wallets": "node src/wallets.mjs",
    "report": "node src/report.mjs",
    "test:browser": "playwright test",
    "test:gateway-browser": "playwright test --config playwright.gateway.config.mjs",
    "test:chains": "node ../../meme/node_modules/tsx/dist/cli.mjs --test chains/*.test.mjs chains/*.test.ts",
    "capture": "node src/capture.mjs",
    "fees": "node src/fee-quote.mjs",
    "accounts": "node src/accounts.mjs",
    "gateway": "node src/gateway.mjs",
    "gateway:probe": "node src/probe-gateway.mjs",
    "operations:probe": "node src/probe-operations.mjs",
    "benchmark": "node ../../meme/node_modules/tsx/dist/cli.mjs load/pilot.ts",
    "benchmark:reads": "node ../../meme/node_modules/tsx/dist/cli.mjs load/readHistory.ts",
    "check": "pnpm test && pnpm report"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@playwright/test": "1.64.1",
    "@solana/spl-token": "0.4.14",
    "@solana/surfpool": "1.7.0",
    "@solana/web3.js": "1.98.4",
    "@sqds/multisig": "2.1.4",
    "viem": "2.55.19"
  }
}
